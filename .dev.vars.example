# GitHub fine-grained Personal Access Token (Permissions: Issues: Read and write)
GITHUB_TOKEN=github_pat_xxx

# Optional: Override repository (defaults to japan4415/training-logger)
# GITHUB_REPO_OWNER=japan4415
# GITHUB_REPO_NAME=training-logger

# Cloudflare Access（本番では両方を設定）
# ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# ACCESS_AUD=your-access-application-audience

# ローカル開発で写真の書き込みを認証なしにする場合のみ有効化
# PHOTO_UPLOAD_ALLOW_UNAUTHENTICATED=1
